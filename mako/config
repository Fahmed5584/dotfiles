# ~/.config/mako/config — dark theme

# --- layout ---
font=monospace 12
width=320
height=180
margin=10
padding=12
border-size=1
border-radius=3
anchor=bottom-left
layer=overlay
max-visible=5
sort=-time

# --- icons ---
icons=1
max-icon-size=48

# --- behaviour ---
default-timeout=5000

# --- colours ---
background-color=#1e1e2ef0
text-color=#cdd6f4
border-color=#585b70
progress-color=over #313244

[urgency=low]
text-color=#a6adc8
border-color=#313244

[urgency=normal]
border-color=#89b4fa

[urgency=critical]
border-color=#f38ba8
default-timeout=0
